# ==============================
# SERVER
# ==============================
PORT=5000
NODE_ENV=production

# A secret password you choose yourself, used to log into /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
# Any long random string (used to sign the admin login session token)
JWT_SECRET=change_this_to_a_long_random_string

# Delivery charges (in Taka)
DELIVERY_CHARGE_INSIDE_DHAKA=70
DELIVERY_CHARGE_OUTSIDE_DHAKA=130

# ==============================
# GOOGLE SHEETS
# ==============================
# The long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# From the service account JSON file Google gives you (see README "Google Sheets Setup")
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON file. Keep the \n characters as-is.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==============================
# TELEGRAM BOT
# ==============================
# Token you get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal or group chat ID (see README "Telegram Bot Setup")
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==============================
# FRONTEND
# ==============================
# The URL where your frontend is hosted (for CORS). Use * only for local testing.
FRONTEND_URL=http://localhost:5000
